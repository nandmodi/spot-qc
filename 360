<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>360 Spin QC Review</title>
<style>
  :root{
    --bg:#eef1f6; --panel:#ffffff; --border:#e2e7f0; --border-strong:#cfd6e4;
    --ink:#161b26; --muted:#6b7482; --faint:#9aa3b2;
    --primary:#4f46e5; --primary-ink:#ffffff;
    --ok:#16a34a; --ok-tint:#ecfdf3; --ok-line:#a7f3c8;
    --edit:#b45309; --edit-tint:#fff7ed; --edit-line:#fcd9a8;
    --mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,monospace;
    --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Inter,Helvetica,Arial,sans-serif;
  }
  *{box-sizing:border-box}
  html,body{height:100%}
  body{
    margin:0;font-family:var(--sans);color:var(--ink);background:var(--bg);
    display:flex;flex-direction:column;height:100vh;overflow:hidden;
  }
  /* ---- top meta bar ---- */
  .topbar{
    background:var(--panel);border-bottom:1px solid var(--border);
    padding:10px 16px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;
  }
  .meta{display:flex;flex-direction:column;gap:2px;min-width:0}
  .meta .k{font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:var(--faint);font-weight:600}
  .meta .v{font-size:14px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:34vw}
  .meta.sku .v{font-family:var(--mono);font-weight:600;font-size:13px;cursor:pointer}
  .meta.sku .v:hover{color:var(--primary)}
  .sep{width:1px;align-self:stretch;background:var(--border)}
  .spacer{flex:1 1 auto}
  .progress{display:flex;flex-direction:column;gap:4px;min-width:180px}
  .progress .txt{font-size:12px;color:var(--muted);display:flex;justify-content:space-between}
  .progress .txt b{color:var(--ink)}
  .bar{height:6px;border-radius:99px;background:#e6eaf1;overflow:hidden}
  .bar > i{display:block;height:100%;width:0;background:var(--primary);transition:width .25s ease}
  .tbtn{
    font:inherit;font-size:13px;font-weight:600;color:var(--muted);
    background:transparent;border:1px solid var(--border-strong);border-radius:8px;
    padding:7px 12px;cursor:pointer;white-space:nowrap;
  }
  .tbtn:hover{border-color:var(--muted);color:var(--ink)}
  /* ---- viewer ---- */
  .stage{flex:1 1 auto;position:relative;padding:16px;min-height:0}
  .viewer{
    width:100%;height:100%;background:var(--panel);border:1px solid var(--border);
    border-radius:14px;overflow:hidden;position:relative;box-shadow:0 1px 2px rgba(20,27,38,.04);
  }
  .viewer iframe{width:100%;height:100%;border:0;display:block}
  .viewer .newtab{
    position:absolute;top:12px;right:12px;font-size:12px;font-weight:600;
    background:rgba(255,255,255,.92);border:1px solid var(--border-strong);border-radius:8px;
    padding:6px 10px;color:var(--ink);text-decoration:none;backdrop-filter:blur(4px);
  }
  .viewer .newtab:hover{border-color:var(--muted)}
  /* ---- states ---- */
  .center{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    flex-direction:column;gap:10px;text-align:center;padding:24px;color:var(--muted)}
  .center h2{margin:0;font-size:16px;color:var(--ink)}
  .center p{margin:0;font-size:13px;max-width:420px}
  .spin{width:26px;height:26px;border:3px solid var(--border-strong);border-top-color:var(--primary);
    border-radius:50%;animation:rot .8s linear infinite}
  @keyframes rot{to{transform:rotate(360deg)}}
  /* ---- action bar ---- */
  .actionbar{
    background:var(--panel);border-top:1px solid var(--border);
    padding:12px 16px;display:grid;grid-template-columns:auto 1fr 1fr auto auto;gap:10px;align-items:stretch;
  }
  .nav{display:flex;gap:8px}
  .status{
    font:inherit;font-size:15px;font-weight:700;cursor:pointer;border-radius:12px;
    border:1.5px solid var(--border-strong);background:var(--panel);color:var(--muted);
    display:flex;align-items:center;justify-content:center;gap:10px;padding:0 16px;min-height:52px;
    transition:transform .05s ease;
  }
  .status .kbd{font-family:var(--mono);font-size:11px;font-weight:600;color:var(--faint);
    border:1px solid var(--border-strong);border-radius:6px;padding:2px 6px;line-height:1}
  .status:active{transform:translateY(1px)}
  .status.edit.sel{background:var(--edit-tint);border-color:var(--edit);color:var(--edit)}
  .status.edit.sel .kbd{border-color:var(--edit);color:var(--edit)}
  .status.ok.sel{background:var(--ok-tint);border-color:var(--ok);color:var(--ok)}
  .status.ok.sel .kbd{border-color:var(--ok);color:var(--ok)}
  .submit{
    font:inherit;font-size:15px;font-weight:700;cursor:pointer;border-radius:12px;border:0;
    background:var(--primary);color:var(--primary-ink);padding:0 22px;min-height:52px;
    display:flex;align-items:center;gap:10px;white-space:nowrap;
  }
  .submit .kbd{font-family:var(--mono);font-size:11px;font-weight:600;color:rgba(255,255,255,.8);
    border:1px solid rgba(255,255,255,.4);border-radius:6px;padding:2px 6px;line-height:1}
  .submit:disabled{background:#c7cad6;cursor:not-allowed}
  .submit:disabled .kbd{opacity:.5}
  .navbtn{font:inherit;font-size:20px;font-weight:600;cursor:pointer;background:var(--panel);
    border:1.5px solid var(--border-strong);border-radius:12px;color:var(--muted);width:52px;min-height:52px}
  .navbtn:hover{border-color:var(--muted);color:var(--ink)}
  .navbtn:disabled{opacity:.4;cursor:not-allowed}
  .toast{
    position:fixed;bottom:96px;left:50%;transform:translateX(-50%) translateY(20px);
    background:var(--ink);color:#fff;padding:10px 16px;border-radius:10px;font-size:13px;font-weight:600;
    opacity:0;pointer-events:none;transition:all .25s ease;z-index:30;
  }
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
  .prevtag{position:absolute;top:12px;left:12px;font-size:11px;font-weight:700;letter-spacing:.04em;
    text-transform:uppercase;padding:5px 10px;border-radius:8px;backdrop-filter:blur(4px)}
  .prevtag.ok{background:var(--ok-tint);color:var(--ok);border:1px solid var(--ok-line)}
  .prevtag.edit{background:var(--edit-tint);color:var(--edit);border:1px solid var(--edit-line)}
  @media (max-width:720px){
    .actionbar{grid-template-columns:1fr 1fr;grid-auto-rows:52px}
    .nav{grid-column:1 / -1;justify-content:space-between}
    .submit{grid-column:1 / -1}
    .meta .v{max-width:60vw}
  }
</style>
</head>
<body>

<div class="topbar" id="topbar">
  <div class="meta"><span class="k">Enterprise</span><span class="v" id="mEnt">—</span></div>
  <div class="sep"></div>
  <div class="meta sku"><span class="k">SKU ID <span style="color:var(--faint);font-weight:500">(click to copy)</span></span><span class="v" id="mSku" title="Click to copy">—</span></div>
  <div class="sep"></div>
  <div class="meta"><span class="k">QC User</span><span class="v" id="mUser">—</span></div>
  <div class="spacer"></div>
  <div class="progress">
    <div class="txt"><span>Reviewed</span><span><b id="pDone">0</b> / <span id="pTotal">0</span></span></div>
    <div class="bar"><i id="pBar"></i></div>
  </div>
  <button class="tbtn" id="btnExport">Export CSV</button>
</div>

<div class="stage">
  <div class="viewer" id="viewer">
    <div class="center" id="loadState">
      <div class="spin"></div>
      <h2>Loading SKUs…</h2>
      <p>Fetching the review list from the source sheet.</p>
    </div>
  </div>
</div>

<div class="actionbar">
  <div class="nav">
    <button class="navbtn" id="btnPrev" title="Previous (←)">‹</button>
    <button class="navbtn" id="btnNext" title="Skip / Next (→)">›</button>
  </div>
  <button class="status edit" id="btnEdit">To be edited <span class="kbd">1</span></button>
  <button class="status ok" id="btnOk">Correct <span class="kbd">2</span></button>
  <button class="submit" id="btnSubmit" disabled>Submit &amp; next <span class="kbd">↵</span></button>
</div>

<div class="toast" id="toast"></div>

<script>
/* ============================ CONFIG ============================ */
const CSV_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vSYR8hKwgq90jMiol1rsSIQ93GrE223VTSQjJkTGudd7OXkBIYJ1xTRmGDAb3Vs2dQ9aRV72UVPjUEz/pub?output=csv';
const SPIN_URL_TEMPLATE = 'https://assets.spyne.ai/360?sku_id={SKU}&input=true';
// Optional: paste a Google Apps Script Web App URL to POST each response there.
// Leave '' to skip (responses still saved locally + exportable as CSV).
const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwy_CR-CCx6qjyhwaZ79GdGERKuBsIkUhgWfqsCOvDuweEPV5Webd-iZM-49Wg8V_L6/exec';
const STORAGE_KEY = 'spin_qc_responses_v1';
/* =============================================================== */

const STATUS = { EDIT: 'To be edited', OK: 'Correct' };

let items = [];          // [{enterprise, sku, qcUser}]
let idx = 0;             // current index
let selected = null;     // STATUS.* selected for current item (not yet submitted)
let responses = load();  // { sku: {sku,status,enterprise,qcUser,ts} }

/* ---------- storage (guarded so preview environments don't crash) ---------- */
function load(){
  try{ return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; }
  catch(e){ return {}; }
}
function persist(){
  try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(responses)); }
  catch(e){ /* no-op in sandboxed previews */ }
}

/* ---------- CSV parsing ---------- */
function parseCSV(text){
  const rows = []; let row = []; let field = ''; let inQ = false; let i = 0;
  while(i < text.length){
    const c = text[i];
    if(inQ){
      if(c === '"'){
        if(text[i+1] === '"'){ field += '"'; i += 2; continue; }
        inQ = false; i++; continue;
      }
      field += c; i++; continue;
    }
    if(c === '"'){ inQ = true; i++; continue; }
    if(c === ','){ row.push(field); field = ''; i++; continue; }
    if(c === '\r'){ i++; continue; }
    if(c === '\n'){ row.push(field); rows.push(row); row = []; field = ''; i++; continue; }
    field += c; i++;
  }
  if(field !== '' || row.length){ row.push(field); rows.push(row); }
  return rows;
}

function norm(s){ return (s || '').toLowerCase().replace(/[\s_]+/g, ' ').trim(); }

function mapColumns(header){
  const map = { sku:-1, enterprise:-1, qcUser:-1 };
  header.forEach((h, i) => {
    const n = norm(h);
    if(map.sku === -1 && n.includes('sku')) map.sku = i;
    else if(map.enterprise === -1 && n.includes('enterprise')) map.enterprise = i;
    else if(map.qcUser === -1 && n.includes('qc')) map.qcUser = i;
  });
  return map;
}

/* ---------- data load ---------- */
async function boot(){
  try{
    const res = await fetch(CSV_URL, { cache: 'no-store' });
    if(!res.ok) throw new Error('HTTP ' + res.status);
    const rows = parseCSV(await res.text()).filter(r => r.some(c => c.trim() !== ''));
    if(!rows.length) throw new Error('empty sheet');

    const m = mapColumns(rows[0]);
    if(m.sku === -1) throw new Error('no "sku id" column found in the sheet');

    items = rows.slice(1)
      .map(r => ({
        sku: (r[m.sku] || '').trim(),
        enterprise: m.enterprise > -1 ? (r[m.enterprise] || '').trim() : '',
        qcUser: m.qcUser > -1 ? (r[m.qcUser] || '').trim() : ''
      }))
      .filter(x => x.sku);

    if(!items.length) throw new Error('no SKUs found');

    idx = firstUnreviewed();
    render();
  }catch(err){
    showError(err.message || String(err));
  }
}

function firstUnreviewed(){
  const i = items.findIndex(x => !responses[x.sku]);
  return i === -1 ? 0 : i;
}

/* ---------- render ---------- */
function render(){
  const it = items[idx];
  document.getElementById('mEnt').textContent  = it.enterprise || '—';
  document.getElementById('mSku').textContent  = it.sku;
  document.getElementById('mUser').textContent = it.qcUser || '—';

  const existing = responses[it.sku];
  selected = existing ? existing.status : null;
  syncStatusButtons();

  // viewer
  const viewer = document.getElementById('viewer');
  const url = SPIN_URL_TEMPLATE.replace('{SKU}', encodeURIComponent(it.sku));
  const tag = existing
    ? `<div class="prevtag ${existing.status === STATUS.OK ? 'ok' : 'edit'}">Reviewed · ${existing.status}</div>`
    : '';
  viewer.innerHTML =
    tag +
    `<a class="newtab" href="${url}" target="_blank" rel="noopener">Open in new tab ↗</a>` +
    `<iframe src="${url}" allow="fullscreen" title="Spin ${it.sku}"></iframe>`;

  // progress
  const done = Object.keys(responses).length;
  document.getElementById('pDone').textContent  = done;
  document.getElementById('pTotal').textContent = items.length;
  document.getElementById('pBar').style.width   = (items.length ? (done / items.length * 100) : 0) + '%';

  document.getElementById('btnPrev').disabled = idx === 0;
  document.getElementById('btnNext').disabled = idx >= items.length - 1;
}

function syncStatusButtons(){
  document.getElementById('btnEdit').classList.toggle('sel', selected === STATUS.EDIT);
  document.getElementById('btnOk').classList.toggle('sel', selected === STATUS.OK);
  document.getElementById('btnSubmit').disabled = !selected;
}

/* ---------- actions ---------- */
function pick(status){ selected = status; syncStatusButtons(); }

async function submit(){
  if(!selected) return;
  const it = items[idx];
  const record = {
    sku: it.sku, status: selected,
    enterprise: it.enterprise, qcUser: it.qcUser,
    ts: new Date().toISOString()
  };
  responses[it.sku] = record;
  persist();
  post(record);
  toast(selected === STATUS.OK ? 'Marked correct' : 'Marked to be edited');
  advance();
}

function advance(){
  const next = items.findIndex((x, i) => i > idx && !responses[x.sku]);
  if(next !== -1){ idx = next; }
  else if(idx < items.length - 1){ idx++; }
  else { render(); toast('All SKUs reviewed 🎉'); return; }
  render();
}
function prev(){ if(idx > 0){ idx--; render(); } }
function next(){ if(idx < items.length - 1){ idx++; render(); } }

function post(record){
  if(!APPS_SCRIPT_URL) return;
  fetch(APPS_SCRIPT_URL, {
    method: 'POST',
    mode: 'no-cors',
    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
    body: JSON.stringify(record)
  }).catch(() => {});
}

/* ---------- export ---------- */
function exportCSV(){
  const recs = items.map(x => responses[x.sku]).filter(Boolean);
  if(!recs.length){ toast('Nothing to export yet'); return; }
  const q = v => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"';
  const header = ['sku id','status','Enterprise','QC User','timestamp'];
  const lines = [header.map(q).join(',')];
  recs.forEach(r => lines.push([r.sku, r.status, r.enterprise, r.qcUser, r.ts].map(q).join(',')));
  const blob = new Blob(['\uFEFF' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'spin_qc_responses_' + new Date().toISOString().slice(0,10) + '.csv';
  document.body.appendChild(a); a.click(); a.remove();
  URL.revokeObjectURL(a.href);
}

/* ---------- ui helpers ---------- */
let toastT;
function toast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  clearTimeout(toastT);
  toastT = setTimeout(() => t.classList.remove('show'), 1600);
}
function showError(msg){
  document.getElementById('viewer').innerHTML =
    `<div class="center"><h2>Couldn't load the review list</h2><p>${msg}</p>` +
    `<p style="color:var(--faint)">Check that the sheet is published to the web as CSV and the link is correct.</p></div>`;
}
function copySku(){
  const sku = items[idx] && items[idx].sku;
  if(!sku) return;
  navigator.clipboard && navigator.clipboard.writeText(sku).then(() => toast('SKU copied'), () => {});
}

/* ---------- wiring ---------- */
document.getElementById('btnEdit').addEventListener('click', () => pick(STATUS.EDIT));
document.getElementById('btnOk').addEventListener('click', () => pick(STATUS.OK));
document.getElementById('btnSubmit').addEventListener('click', submit);
document.getElementById('btnPrev').addEventListener('click', prev);
document.getElementById('btnNext').addEventListener('click', next);
document.getElementById('btnExport').addEventListener('click', exportCSV);
document.getElementById('mSku').addEventListener('click', copySku);

document.addEventListener('keydown', (e) => {
  if(e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
  if(e.key === '1'){ pick(STATUS.EDIT); }
  else if(e.key === '2'){ pick(STATUS.OK); }
  else if(e.key === 'Enter'){ e.preventDefault(); submit(); }
  else if(e.key === 'ArrowLeft'){ prev(); }
  else if(e.key === 'ArrowRight'){ next(); }
});

boot();
</script>
</body>
</html>
